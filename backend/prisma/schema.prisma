// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Models are added incrementally, one PRD phase at a time. This is the first:
// User, which is consumed by Phase 2 (authentication).
// The connection string lives in .env and is wired up in prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Account that owns habits, challenges, and memory in Habitra.
/// Created during registration (Phase 2); this model only defines the shape.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  habits Habit[]
  /// Cascade-deleted when the user is removed.
  habitCompletions HabitCompletion[]
  /// Cascade-deleted when the user is removed.
  passwordResetTokens PasswordResetToken[]
  /// Challenge records owned by this user. Cascade-deleted with the user.
  challenges Challenge[]
  /// Connected wallets. Cascade-deleted with the user.
  wallets Wallet[]
  /// On-chain / demo transactions. Cascade-deleted with the user.
  transactions Transaction[]
}

/// A recurring habit owned by a User (PRD section 7).
/// Only the data model is added here; routes/controllers/services come later.
model Habit {
  id            String   @id @default(cuid())
  userId        String
  name          String
  description   String?
  frequency     String
  target        Int
  preferredTime String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Owning user. Deleting the user cascade-deletes their habits.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Daily completion/miss records for this habit. Cascade-deleted with the habit.
  completions HabitCompletion[]
  /// Challenge links for this habit. Restrict prevents habit deletion while linked.
  challengeLinks ChallengeHabit[]

  @@index([userId])
}

/// A single daily record of a habit being completed or missed (PRD section 8).
/// Only the data model is added here; the completion/API routes come in a later
/// stage. `status` is `COMPLETED` or `MISSED` (enforced by the application layer,
/// kept as a plain String like the other enum-like columns). `date` is the
/// calendar day the record applies to and must be normalized (e.g. start-of-day
/// UTC) by callers; the unique constraint on (habitId, date) guarantees at most
/// one record per habit per day.
model HabitCompletion {
  id         String   @id @default(cuid())
  habitId    String
  userId     String
  date       DateTime
  status     String
  missReason String?
  createdAt  DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Lookups by owner, by habit, by day, and by owner+day / habit+day.
  @@index([userId])
  @@index([habitId])
  @@index([date])
  @@index([userId, date])
  /// At most one record per habit per calendar date.
  @@unique([habitId, date])
}

/// A single-use, expiring password-reset token (PRD password-reset flow).
/// Only the SHA-256 hash of the raw token is stored; the raw token is emailed
/// to the user and never persisted. Tokens are deleted after use (single-use),
/// and a new forgot-password request deletes any prior unused tokens for the
/// user, so only the latest link is ever valid.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  /// Owning user. Deleting the user cascade-deletes their reset tokens.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Lookups by owner.
  @@index([userId])
}

/// An off-chain user-owned challenge definition and lifecycle record.
model Challenge {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  status       String   @default("DRAFT")
  startDate    DateTime
  endDate      DateTime
  durationDays Int
  maxMisses    Int      @default(0)
  committedAt  DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  failReason   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Owning user. Deleting the user cascade-deletes their challenges.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Habit links for this challenge. Cascade-deleted with the challenge.
  habitLinks ChallengeHabit[]

  @@index([userId, status])
  @@index([userId, startDate, endDate])
}

/// Join table linking a challenge to one or more required habits.
model ChallengeHabit {
  id          String @id @default(cuid())
  challengeId String
  habitId     String

  /// Deleting a challenge cascade-deletes its challenge-habit links.
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  /// Habit deletion is restricted while linked from any challenge.
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Restrict)

  @@unique([challengeId, habitId])
  @@index([habitId])
}

/// A blockchain wallet a user has connected (PRD §22). Only the public address is
/// stored — private keys, seed phrases, and wallet passwords are NEVER persisted
/// (PRD §22, §30). A (address, chainId) pair is unique, so the same EVM address
/// cannot be registered twice on the same chain for the same or a different user.
model Wallet {
  id        String   @id @default(cuid())
  userId    String
  /// Public EVM address (0x...). Stored only; never any secret material.
  address   String
  /// EVM chain id this wallet is associated with. Defaults to Base Sepolia (84532).
  chainId   Int      @default(84532)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Owning user. Deleting the user cascade-deletes their wallets.
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Transactions signed/owned by this wallet. Cascade-deleted with the wallet.
  transactions Transaction[]

  /// Lookups by owner.
  @@index([userId])
  /// One wallet record per (address, chain): an EVM address is unique per chain.
  @@unique([address, chainId])
}

/// An on-chain (or demo-mode) transaction tied to a user's wallet and, where
/// applicable, a challenge (PRD §19, §21). `type` and `status` are plain strings
/// (type = FUND | CLAIM | PENALTY; status = PENDING | CONFIRMED | FAILED), kept as
/// String like the other enum-like columns in this schema. Amount is in token base
/// units as a BigInt to avoid precision loss.
model Transaction {
  id           String   @id @default(cuid())
  userId       String
  walletId     String
  /// Optional link to the challenge this transaction funds or rewards. Plain id
  /// reference (no FK yet) to avoid coupling the schema to the off-chain Challenge
  /// model until the reward flow is implemented.
  challengeId  String?
  /// FUND (challenge funding/commitment) | CLAIM (reward claim) | PENALTY.
  type         String
  /// PENDING | CONFIRMED | FAILED.
  status       String   @default("PENDING")
  /// On-chain transaction hash, once broadcast. Nullable for pre-broadcast /
  /// demo-mode records. Indexed for lookups; not globally unique because demo or
  /// retried records may carry placeholder/duplicate values.
  txHash       String?
  /// EVM chain id the transaction targets. Defaults to Base Sepolia (84532).
  chainId      Int      @default(84532)
  /// Token amount in base units (BigInt). Nullable for non-amount transactions.
  amount       BigInt?
  /// ERC-20 token address the amount refers to (e.g. BEES). Nullable.
  tokenAddress String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Owning user. Deleting the user cascade-deletes their transactions.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Wallet that signed/owns this transaction. Cascade-deleted with the wallet.
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([challengeId])
  @@index([txHash])
  @@index([userId, status])
}
