// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Models are added incrementally, one PRD phase at a time. This is the first:
// User, which is consumed by Phase 2 (authentication).
// The connection string lives in .env and is wired up in prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Account that owns habits, challenges, and memory in Habitra.
/// Created during registration (Phase 2); this model only defines the shape.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  habits Habit[]
}

/// A recurring habit owned by a User (PRD section 7).
/// Only the data model is added here; routes/controllers/services come later.
model Habit {
  id            String   @id @default(cuid())
  userId        String
  name          String
  description   String?
  frequency     String
  target        Int
  preferredTime String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Owning user. Deleting the user cascade-deletes their habits.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
