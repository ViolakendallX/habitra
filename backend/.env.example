# Node environment: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# Secret used to sign authentication JWTs (jsonwebtoken).
# Generate a long random value, e.g.:  openssl rand -base64 48
# Never commit a real secret; this file is a template.
JWT_SECRET="replace-with-a-long-random-secret"

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Replace USER and PASSWORD with your local PostgreSQL credentials.
# Prefer 127.0.0.1 over localhost: on Windows localhost can resolve to ::1 (IPv6),
# which most local PostgreSQL installs do not listen on.
# sslmode=disable is needed when the server does not perform the PostgreSQL
# SSLRequest handshake (embedded/WASM PostgreSQL builds); drop it otherwise.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/habitra?schema=public&sslmode=disable&connect_timeout=30"

# Google Gemini API key used by the Habitra agent (server-side only).
# Create one in Google AI Studio. Never commit a real key and never expose it
# to the frontend or in logs.
GEMINI_API_KEY=
