# Node environment: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# Secret used to sign authentication JWTs (jsonwebtoken).
# Generate a long random value, e.g.:  openssl rand -base64 48
# Never commit a real secret; this file is a template.
JWT_SECRET="replace-with-a-long-random-secret"

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Replace USER and PASSWORD with your local PostgreSQL credentials.
# Prefer 127.0.0.1 over localhost: on Windows localhost can resolve to ::1 (IPv6),
# which most local PostgreSQL installs do not listen on.
# sslmode=disable is needed when the server does not perform the PostgreSQL
# SSLRequest handshake (embedded/WASM PostgreSQL builds); drop it otherwise.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/habitra?schema=public&sslmode=disable&connect_timeout=30"

# Google Gemini API key used by the Habitra agent (server-side only).
# Create one in Google AI Studio. Never commit a real key and never expose it
# to the frontend or in logs.
GEMINI_API_KEY=

# --- Password-reset email delivery (MVP) ---
# No real credentials are committed. To enable real email, set EMAIL_PROVIDER=smtp
# and fill in SMTP_* for your provider (e.g. SendGrid, Mailgun, Amazon SES, Postfix).
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@habitra.app
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Base URL of the deployed frontend; the reset link points here.
APP_URL=http://localhost:5173
# How long a reset token stays valid, in minutes.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# --- Sibyl Memory (STEP 9 foundation; local-first, opt-OUT) ---
# Sibyl is ENABLED unless this is explicitly 'false'. Habit/behavior/preference
# signals are mirrored into a local SQLite-backed Sibyl store keyed by the
# authenticated user id. Set to 'false' to disable memory entirely (all memory
# calls become safe no-ops; nothing is spawned and PostgreSQL is unaffected).
SIBYL_ENABLED=true
# Absolute or workspace-relative path to the local Sibyl SQLite database.
# Defaults to backend/.data/sibyl-memory.db when unset.
SIBYL_DB_PATH=
# Python interpreter that has sibyl-memory-client installed (the isolated venv).
# Defaults to backend/.venv/Scripts/python.exe (Windows) or .venv/bin/python.
SIBYL_PYTHON=
# Path to the Python bridge script. Defaults to backend/scripts/sibyl_bridge.py.
SIBYL_BRIDGE_SCRIPT=
