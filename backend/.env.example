# Node environment: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# Secret used to sign authentication JWTs (jsonwebtoken).
# Generate a long random value, e.g.:  openssl rand -base64 48
# Never commit a real secret; this file is a template.
JWT_SECRET="replace-with-a-long-random-secret"

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Replace USER and PASSWORD with your local PostgreSQL credentials.
# Prefer 127.0.0.1 over localhost: on Windows localhost can resolve to ::1 (IPv6),
# which most local PostgreSQL installs do not listen on.
# sslmode=disable is needed when the server does not perform the PostgreSQL
# SSLRequest handshake (embedded/WASM PostgreSQL builds); drop it otherwise.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/habitra?schema=public&sslmode=disable&connect_timeout=30"

# Google Gemini API key used by the Habitra agent (server-side only).
# Create one in Google AI Studio. Never commit a real key and never expose it
# to the frontend or in logs.
GEMINI_API_KEY=

# --- Password-reset email delivery (MVP) ---
# No real credentials are committed. To enable real email, set EMAIL_PROVIDER=smtp
# and fill in SMTP_* for your provider (e.g. SendGrid, Mailgun, Amazon SES, Postfix).
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@habitra.app
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Base URL of the deployed frontend; the reset link points here.
APP_URL=http://localhost:5173
# How long a reset token stays valid, in minutes.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# --- Sibyl Memory (STEP 9 foundation; local-first, opt-OUT) ---
# Sibyl is ENABLED unless this is explicitly 'false'. Habit/behavior/preference
# signals are mirrored into a local SQLite-backed Sibyl store keyed by the
# authenticated user id. Set to 'false' to disable memory entirely (all memory
# calls become safe no-ops; nothing is spawned and PostgreSQL is unaffected).
SIBYL_ENABLED=true
# Absolute or workspace-relative path to the local Sibyl SQLite database.
# Defaults to backend/.data/sibyl-memory.db when unset.
SIBYL_DB_PATH=
# Python interpreter that has sibyl-memory-client installed (the isolated venv).
# Defaults to backend/.venv/Scripts/python.exe (Windows) or .venv/bin/python.
SIBYL_PYTHON=
# Path to the Python bridge script. Defaults to backend/scripts/sibyl_bridge.py.
SIBYL_BRIDGE_SCRIPT=

# --- Virtuals ACP v2 intervention executor (optional; server-side only) ---
# Keep OFF by default. When false/missing, Habitra keeps using the local mock
# intervention client (no network, no wallet, no payment).
VIRTUALS_ACP_ENABLED=false
# Provider selector for the action-layer backend. Supported value:
#   virtuals_acp_v2
VIRTUALS_ACP_PROVIDER=virtuals_acp_v2
# ACP chain target. Supported values: base | baseSepolia
VIRTUALS_ACP_CHAIN=baseSepolia
# ACP v2 needs TWO Habitra-owned participants on SEPARATE wallets: the buyer
# cannot be the seller (see the acp-node-v2 README). Both sets below must be
# present and structurally valid before the ACP backend is selected; anything
# missing or malformed degrades Habitra back to the local mock client.

# --- SELLER: the registered "Habitra" agent that owns the offering ---
# Must be a 20-byte hex EVM address (0x + 40 hex chars).
VIRTUALS_EVM_WALLET_ADDRESS=
VIRTUALS_EVM_WALLET_ID=
# Privy authorization private key (base64 PKCS#8), not an EOA key.
VIRTUALS_EVM_SIGNER_PRIVATE_KEY=

# --- BUYER: a separate agent/wallet that creates and funds ACP jobs ---
VIRTUALS_BUYER_EVM_WALLET_ADDRESS=
VIRTUALS_BUYER_EVM_WALLET_ID=
VIRTUALS_BUYER_EVM_SIGNER_PRIVATE_KEY=

# Offering registered on the Virtuals Service Registry (a name, not a secret).
VIRTUALS_ACP_OFFERING_NAME=accountabilityIntervention
# Fixed price of that offering, in USDC. Must match the registry entry.
VIRTUALS_ACP_PRICE_USD=0.01
# Budget for the on-chain job-creation transaction (milliseconds). Separate from
# VIRTUALS_ACP_TIMEOUT_MS because creating a job is a real transaction.
VIRTUALS_ACP_JOB_TIMEOUT_MS=60000
# Optional Virtuals builder attribution code (bc-...).
VIRTUALS_ACP_BUILDER_CODE=
# Optional timeout override (milliseconds) for intervention dispatch.
VIRTUALS_ACP_TIMEOUT_MS=10000

# --- Base + BEES (blockchain foundation; PRD §19–23, §30) ---
# Set to 'true' for local/offline development: reward/penalty logic is stubbed
# and NO on-chain calls are made. In development this defaults to true if unset.
# Set to 'false' (and provide BASE_RPC_URL + the addresses below) to enable
# real on-chain reads via a viem PublicClient against Base Sepolia.
DEMO_CHAIN_MODE=true
# Base Sepolia RPC endpoint. Required only when DEMO_CHAIN_MODE=false.
BASE_RPC_URL=
# Base Sepolia chain id (84532).
BASE_CHAIN_ID=84532
# BEES ERC-20 token address on Base Sepolia (set after deployment).
BEES_TOKEN_ADDRESS=
# ChallengeRewards contract address on Base Sepolia (set after deployment).
CHALLENGE_CONTRACT_ADDRESS=
# Resolver key used ONLY to call HabitraChallengeEscrow.settle() when
# DEMO_CHAIN_MODE=false. NEVER commit a real value here. Read from the
# environment at run time; never logged and never sent to any client.
# Leave empty to disable on-chain settlement (the demo path still works).
ESCROW_RESOLVER_PRIVATE_KEY=
